OPENROUTER_API_KEY=your_openrouter_key_here

# Base URL of the running Prowl API
POUNCE_API_BASE_URL=http://localhost:8000

# Credentials used to log in to Prowl
POUNCE_PORTAL_EMAIL=you@example.com
POUNCE_PORTAL_PASSWORD=your_password_here

# Paths to your resume and profile markdown
POUNCE_RESUME_PATH=/path/to/resume.pdf
POUNCE_PROFILE_PATH=/path/to/profile.md

# Models (OpenRouter model IDs)
POUNCE_MODEL=anthropic/claude-sonnet-4-5
POUNCE_VISION_MODEL=anthropic/claude-sonnet-4-5

# Browser settings
POUNCE_HEADLESS=true
POUNCE_SLOW_MO=0
POUNCE_STEP_TIMEOUT=30
POUNCE_MAX_AGENT_TURNS=40
