OPENROUTER_API_KEY=your_openrouter_key_here

# JWT signing secret — use a long random string in production
SECRET_KEY=change-me-in-production

# Auto-created admin account credentials (defaults: admin@prowl.app / admin123)
ADMIN_EMAIL=admin@prowl.app
ADMIN_PASSWORD=admin123

# PostgreSQL — required
DATABASE_URL=postgresql://user:password@localhost:5432/jobscrapper

# Redis — required for Celery workers
REDIS_URL=redis://localhost:6379/0

# Docker only: worker pool sizes for the scrape/score queues (see docker-compose.yaml).
# Scoring is mostly I/O-bound (LLM API calls), so it can usually run higher concurrency
# than scraping without issue.
CELERY_SCRAPE_CONCURRENCY=2
CELERY_SCORE_CONCURRENCY=4

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# Stage 1: bulk candidate filtering (cheap + fast)
# e.g. openai/gpt-4o-mini, google/gemini-2.5-flash-lite
FILTER_MODEL=openai/gpt-4o-mini

# Stage 2: deep JD match scoring — use a reward/evaluation-tuned model for best results
# e.g. nvidia/nemotron-3-super-120b-a12b, google/gemini-2.5-flash
SCORE_MODEL=nvidia/nemotron-3-super-120b-a12b

# Prowl AI chat
INSIGHTS_MODEL=openai/gpt-4o-mini

# Delay between requests per company (seconds) — be polite
REQUEST_DELAY=1.5

# Max jobs to fetch per company per run
MAX_JOBS_PER_COMPANY=200

# Max companies scraped concurrently within a single scrape run (per platform group)
SCRAPE_CONCURRENCY=5

# Days to keep job listings before auto-deletion
LISTING_RETENTION_DAYS=15

# Pricing per million tokens (USD) — used for per-run cost display
# Check current rates at openrouter.ai/models
FILTER_MODEL_PRICE_IN=0.15
FILTER_MODEL_PRICE_OUT=0.60
SCORE_MODEL_PRICE_IN=0.09
SCORE_MODEL_PRICE_OUT=0.45
# Set to 1.0 if your score model doesn't support prompt caching (e.g. Nemotron)
SCORE_MODEL_CACHE_DISCOUNT=1.0

# Nexus notification integration — Prowl POSTs job matches here after each score run
NEXUS_NOTIFY_URL=
NEXUS_API_KEY=
# Public URL of this Prowl instance — included in notification messages as a deep link
PROWL_URL=https://your-prowl-domain.com

