OPENROUTER_API_KEY=your_openrouter_key_here

# Stage 1: bulk candidate filtering
FILTER_MODEL=google/gemini-2.5-flash-lite

# Stage 2: deep JD match scoring
SCORE_MODEL=google/gemini-2.5-flash-lite

# Delay between requests per company (seconds) — be polite
REQUEST_DELAY=1.5

# Max jobs to fetch per company before filtering
MAX_JOBS_PER_COMPANY=200
