OPENROUTER_API_KEY=your_openrouter_key_here

# Stage 1: bulk candidate filtering (cheap + fast, implicit caching)
FILTER_MODEL=google/gemini-2.5-flash-lite

# Stage 2: deep JD match scoring (quality model for calibrated scoring)
SCORE_MODEL=google/gemini-2.5-flash

# Delay between requests per company (seconds) — be polite
REQUEST_DELAY=1.5

# Max jobs to fetch per company before filtering
MAX_JOBS_PER_COMPANY=200

# Pricing per million tokens (USD) — used for per-run cost display
# Gemini 2.5 Flash Lite (Stage 1)
FILTER_MODEL_PRICE_IN=0.10
FILTER_MODEL_PRICE_OUT=0.40
# Gemini 2.5 Flash (Stage 2)
SCORE_MODEL_PRICE_IN=0.15
SCORE_MODEL_PRICE_OUT=0.60
# Cached input tokens cost 25% of normal input price (Gemini implicit caching)
SCORE_MODEL_CACHE_DISCOUNT=0.25
