OPENROUTER_API_KEY=your_openrouter_key_here

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/jobscrapper

# Stage 1: bulk candidate filtering (cheap + fast)
FILTER_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Stage 2: deep JD match scoring
SCORE_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Delay between requests per company (seconds) — be polite
REQUEST_DELAY=1.5

# Max jobs to fetch per company before filtering
MAX_JOBS_PER_COMPANY=200

# Pricing per million tokens (USD) — used for per-run cost display
# Check current rates at openrouter.ai/models
FILTER_MODEL_PRICE_IN=0.12
FILTER_MODEL_PRICE_OUT=0.30
SCORE_MODEL_PRICE_IN=0.12
SCORE_MODEL_PRICE_OUT=0.30
# Set to 1.0 if your model doesn't support prompt caching
SCORE_MODEL_CACHE_DISCOUNT=1.0
